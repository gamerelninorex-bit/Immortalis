{
  "name": "immortalis",
  "private": true,
  "version": "0.0.0",
  "description": "IMMORTALIS implementation workspace (provider-neutral Resurreccion Core). Bootstrap only.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:spec": "node --experimental-strip-types tools/check-spec.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:conformance": "vitest run --project conformance",
    "test:security": "vitest run --project security",
    "test:integration": "vitest run --project integration",
    "ci": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run check:spec && pnpm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@immortalis/contracts": "workspace:*",
    "@immortalis/engine": "workspace:*",
    "@immortalis/protocol": "workspace:*",
    "@immortalis/testkit": "workspace:*",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2",
    "yaml": "2.9.1"
  }
}
